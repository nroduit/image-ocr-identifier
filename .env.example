# Port to run the server on (defaults to 8000 when unset).
PORT=8000
API_PORT=9200

# Logging level (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Number of uvicorn workers (defaults to CPU count when unset).
# WORKERS=4

# Base directory containing the "models" folder.
# MODEL_DATA_PATH=./data

# OCR backend: "paddle" (server, default) or "rapid" (portable, ONNX).
# OCR_BACKEND=paddle

# --- paddle backend (OCR_BACKEND=paddle) ---
# OCR model selection (logical names under <MODEL_DATA_PATH>/models).
# OCR_DET_MODEL=PP-OCRv6_medium_det
# OCR_REC_MODEL=PP-OCRv6_medium_rec

# Explicit model directory overrides (bypass the names above).
# OCR_DET_MODEL_DIR=/path/to/models/detection/PP-OCRv6_medium_det
# OCR_REC_MODEL_DIR=/path/to/models/recognition/PP-OCRv6_medium_rec

# --- rapid backend (OCR_BACKEND=rapid) ---
# ONNX model selection (folders under <MODEL_DATA_PATH>/models/onnx).
# Available: PP-OCRv5_mobile, PP-OCRv6_tiny, PP-OCRv6_small, PP-OCRv6_medium
# OCR_MODEL=PP-OCRv5_mobile

# Set to 1/true/yes to save debug images to output/debug_images.
# DEBUG_IMAGES=True

# --- docker compose only (ignored when running outside compose) ---
# Host port the API is published on (container port stays PORT above).
# API_PORT=8000

# Models baked into the image at build time (also used as the runtime models).
# DET_MODEL=PP-OCRv6_medium_det
# REC_MODEL=PP-OCRv6_medium_rec

# CPU profile: worker count (each worker loads the models into RAM).
# CPU_WORKERS=2

# GPU profile: worker count (keep low, each worker loads models into VRAM).
# GPU_WORKERS=1

# GPU profile: CUDA target and matching paddlepaddle-gpu version. Match these
# to the host driver (see docker/Dockerfile.gpu).
# CUDA_TAG=cu126
# PADDLE_GPU_VERSION=3.3.1
